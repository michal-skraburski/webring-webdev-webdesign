---
type Props = {
  name: string;
  url: string;
  description?: string;
};

const { name, url, description } = Astro.props;
---

<li class="member">
  <a class="member__link" href={url} target="_blank" rel="noopener noreferrer"
    >{name}</a
  >
  {description && <p class="member__desc">{description}</p>}
</li>

<style>
  .member {
    list-style: none;
    margin: 0;
    padding: 1rem 1.125rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
  }

  .member__link {
    font-weight: 600;
    color: var(--link);
    text-decoration: none;
  }

  .member__link:hover,
  .member__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .member__desc {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
  }
</style>
